# Files NOT uploaded by `gcloud run deploy --source .`.
# Without this file gcloud falls back to .gitignore; we want to be explicit so .env,
# local data and node_modules never leave the machine. The Dockerfile needs everything else.
.gcloudignore
.git
.gitignore
.claude
.venv
**/__pycache__
.pytest_cache

.env
.env.*
!.env.example
*.json.key
service-account*.json
secrets/
data/
uploads/

dashboard/node_modules
dashboard/dist
**/*.tsbuildinfo
tests/eval_data/out/
