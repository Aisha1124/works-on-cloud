# Keep the build context small and secrets out of the image.
.git
.gitignore
.claude
.venv
**/__pycache__
**/*.pyc
.pytest_cache

# Secrets and local data
.env
.env.*
!.env.example
*.json.key
service-account*.json
secrets/
data/
uploads/

# Built inside the image instead
dashboard/node_modules
dashboard/dist
**/*.tsbuildinfo

# Not needed at runtime
tests/
scripts/
docs/
infra/
*.md
