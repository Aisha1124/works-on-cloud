# Gemini. Local development: GEMINI_API_KEY. Production: Vertex AI with
# GOOGLE_GENAI_USE_VERTEXAI=true (project GCP_PROJECT_ID, the service account's credentials,
# no API key). The Interactions API on Vertex AI is served from GEMINI_LOCATION=global only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_LOCATION=global

# Google Cloud
GCP_PROJECT_ID=
GCP_REGION=asia-southeast1
FIRESTORE_DATABASE=(default)
GCS_BUCKET=

# App
STORE_BACKEND=local
BASE_URL=http://localhost:8000
# Owner key of the sample shop mak-kuih (seeded at startup). It opens that shop only.
# Every other shop gets its own random key when it goes live.
OWNER_KEY=
# Optional: owner email of the sample shop (gets its order emails).
SAMPLE_OWNER_EMAIL=
# Who runs this site: receives "report this shop" messages and data deletion requests, and is
# shown on the /privacy page.
ADMIN_EMAIL=

# Email. EMAIL_PROVIDER=smtp (default) sends through Gmail SMTP with an app password
# (Google account > Security > 2-Step Verification > App passwords). It can email any owner.
# EMAIL_PROVIDER=resend uses Resend: without a verified domain, onboarding@resend.dev can only
# send to the email address of your own Resend account.
# Without the chosen provider's credentials, emails are only logged.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
# Empty: "KampungCart <SMTP_USER>" (smtp) or "KampungCart <onboarding@resend.dev>" (resend).
EMAIL_FROM=
