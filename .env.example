# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google Cloud
GCP_PROJECT_ID=
GCP_REGION=asia-southeast1
FIRESTORE_DATABASE=(default)
GCS_BUCKET=

# App
STORE_BACKEND=local
BASE_URL=http://localhost:8000
# Owner key of the sample shop mak-kuih (seeded at startup). It opens that shop only.
# Every other shop gets its own random key when it goes live.
OWNER_KEY=
